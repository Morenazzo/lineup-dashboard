# Copy this file to .env.local and fill it in. Never commit .env.local.

# --- Supabase (required for the dashboard) ----------------------------------
# Project Settings, API. Both are safe to expose: the database is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Who may sign in --------------------------------------------------------
# Your email (comma separated if you must). It also has to be inserted into public.admins:
#   insert into public.admins (email) values ('you@example.com');
ADMIN_EMAILS=

# The public address of the site. Used when a sign-in link has no host to return to.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- The AI coach (optional) ------------------------------------------------
# Server-only. Without it the dashboard works and the coach says it is not configured.
OPENROUTER_API_KEY=
# Default model id, as OpenRouter names it. Default: anthropic/claude-sonnet-5.5
# AI_MODEL=anthropic/claude-sonnet-5.5

# --- Try it without Supabase ------------------------------------------------
# LINEUP_DEMO=1 opens /dashboard with no sign-in; data stays in this browser only.
# Ignored in production builds. Handy for a first look: LINEUP_DEMO=1 npm run dev
# LINEUP_DEMO=1
